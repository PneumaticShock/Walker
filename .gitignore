# Based on github/gitignore Unity.gitignore

# Generated by Unity, and rebuilt on first open
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Can get large, and memory captures can hold sensitive data
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Generated IDE and solution files
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
/[Aa]ssets/Plugins/Editor/JetBrains*

# Meta files Unity generates for the debug files above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Build output
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Addressables and Android output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Local Claude Code settings
.claude/settings.local.json

# Bench output. Only the results the docs cite are tracked.
/BalanceResults/*
!/BalanceResults/recovery-final4.json
!/BalanceResults/recovery-final5.json
!/BalanceResults/validation.json
